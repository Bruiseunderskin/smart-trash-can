menu "TFLite probe"

config TFLITE_PROBE_USE_ESP_NN
    bool "Enable ESP-NN optimized kernels"
    default y
    help
        Compile the ESP-TFLite-Micro kernels with ESP-NN enabled. Disable this
        option to run the portable reference kernels for the A/B comparison.

config TFLITE_PROBE_MODEL_LABEL
    string "Embedded model label"
    default "unspecified"
    help
        Label printed in the monitor output. Keep it in sync with the model
        embedded as models/waste4_int8.tflite.

endmenu
